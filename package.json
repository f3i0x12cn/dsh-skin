{
  "name": "dsh-skin",
  "version": "1.1.0",
  "description": "Appearance skin for the DeepSeek Harness Web client: photo background with glass panes, blue whale brand mark, rainbow deepseek wordmark, and one solid colour per workspace name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f3i0x12cn/dsh-skin.git"
  },
  "homepage": "https://github.com/f3i0x12cn/dsh-skin#readme",
  "bugs": "https://github.com/f3i0x12cn/dsh-skin/issues",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "install.sh",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "skin",
    "theme",
    "brand"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
